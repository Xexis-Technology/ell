{
    "name": "exotic-lane-limo/app",
    "description": "Exotic Lane Limo - Phase 1 luxury chauffeur booking system",
    "type": "project",
    "require": {
        "php": ">=8.3",
        "phpmailer/phpmailer": "^6.9",
        "stripe/stripe-php": "^16.0",
        "dompdf/dompdf": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "classmap": [
            "app/Core/",
            "app/Services/",
            "app/Middleware/"
        ],
        "files": [
            "app/Helpers/functions.php"
        ]
    },
    "config": {
        "optimize-autoloader": true
    }
}
